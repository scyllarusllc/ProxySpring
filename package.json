{
  "name": "proxyspring",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -i web/src/app.css -o app/static/css/app.css --minify",
    "build:js": "esbuild web/src/check.ts --bundle --minify --format=iife --target=es2022 --outfile=app/static/js/check.js",
    "vendor": "node scripts/vendor-fontawesome.mjs",
    "build:web": "npm run vendor && npm run build:css && npm run build:js",
    "build:ext": "vite build --config vite.ext.config.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && npm run build:web && npm run build:ext",
    "test": "tsx --test shared/*.test.ts"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "7.3.1",
    "@tailwindcss/cli": "4.3.5",
    "@types/chrome": "0.1.31",
    "@types/node": "^22.20.7",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "esbuild": "0.28.2",
    "tailwindcss": "4.3.5",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true
  }
}
